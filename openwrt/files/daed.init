#!/bin/sh /etc/rc.common
# SPDX-License-Identifier: MIT
USE_PROCD=1
START=99
STOP=10

start_service() {
	local enabled listen
	config_load daed
	config_get_bool enabled main enabled 0
	[ "$enabled" = 1 ] || return 0
	if ! /usr/libexec/daed/check --check; then
		logger -t daed 'Compatibility/configuration check failed; see Services > NaiLink.'
		return 1
	fi
	listen=$(/usr/libexec/daed/check --listen) || return 1
	[ -x /usr/bin/daed ] || return 1
	mkdir -p /etc/daed /var/log/daed
	chmod 700 /etc/daed /var/log/daed
	/usr/libexec/daed/luci-proxy --prepare || return 1
	procd_open_instance main
	procd_set_param command /usr/bin/daed run --config /etc/daed --listen "$listen" \
		--logfile /var/log/daed/daed.log --logfile-maxsize 1 --logfile-maxbackups 1
	procd_set_param env DAED_SUBSCRIPTION_PROXY_HELPER=/usr/libexec/daed/subscription-proxy
	# Give dae time to detach its own eBPF programs on SIGTERM.
	procd_set_param term_timeout 30
	procd_set_param respawn 3600 5 5
	procd_set_param limits nofile="1048576 1048576"
	procd_set_param stderr 1
	procd_close_instance
}

reload_service() {
	restart
}

service_triggers() {
	local lan
	config_load daed
	config_get lan main lan_network lan
	procd_add_reload_trigger daed
	procd_add_interface_trigger 'interface.*' "$lan" /etc/init.d/daed reload
}
