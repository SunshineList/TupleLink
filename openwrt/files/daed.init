#!/bin/sh /etc/rc.common
# SPDX-License-Identifier: MIT
USE_PROCD=1
START=99
STOP=10

start_service() {
	local enabled listen mixed_enabled mixed_port mixed_lan mixed_host mixed_listen mixed_error
	config_load daed
	config_get_bool enabled main enabled 0
	[ "$enabled" = 1 ] || return 0
	if ! /usr/libexec/daed/check --check; then
		logger -t daed 'Compatibility/configuration check failed; see Services > NaiLink.'
		return 1
	fi
	listen=$(/usr/libexec/daed/check --listen) || return 1
	[ -x /usr/bin/daed ] || return 1
	mkdir -p /etc/daed /var/log/daed /var/run/daed
	chmod 700 /etc/daed /var/log/daed /var/run/daed
	/usr/libexec/daed/luci-proxy --prepare || return 1
	mixed_listen=''
	mixed_error=''
	config_get_bool mixed_enabled main mixed_enabled 0
	if [ "$mixed_enabled" = 1 ]; then
		config_get mixed_port main mixed_port 7893
		config_get_bool mixed_lan main mixed_lan 0
		case "$mixed_port" in
			''|*[!0-9]*) mixed_error=invalid_port ;;
			*) [ "${#mixed_port}" -le 5 ] && [ "$mixed_port" -ge 1024 ] && [ "$mixed_port" -le 65535 ] || mixed_error=invalid_port ;;
		esac
		[ "$mixed_port" != "${listen##*:}" ] || mixed_error=invalid_port
		mixed_host=127.0.0.1
		if [ "$mixed_lan" = 1 ]; then
			mixed_host=$(/usr/libexec/daed/mixed-settings --host) || mixed_host=''
			[ -n "$mixed_host" ] || mixed_error=lan_unavailable
		fi
		[ -n "$mixed_error" ] || mixed_listen="$mixed_host:$mixed_port"
	fi
	procd_open_instance main
	# 日志容量按 debug 级别估过：把 log_level 调成 debug 排查分流时，
	# 一次刷网页就能写出几十 KB，1 MB 上限只够几分钟。4 MB × 2 个文件
	# 约合十几分钟到半小时的真实排障窗口，闪存占用仍然很小。
	procd_set_param command /usr/bin/daed run --config /etc/daed --listen "$listen" \
		--logfile /var/log/daed/daed.log --logfile-maxsize 4 --logfile-maxbackups 2
	procd_set_param env DAED_MIXED_ERROR="$mixed_error" DAED_MIXED_LISTEN="$mixed_listen" DAED_SUBSCRIPTION_PROXY_HELPER=/usr/libexec/daed/subscription-proxy DAED_RESTART_STATE=/var/run/daed/restart-state.json
	# Give dae time to detach its own eBPF programs on SIGTERM.
	procd_set_param term_timeout 30
	procd_set_param respawn 3600 5 5
	procd_set_param limits nofile="1048576 1048576"
	procd_set_param stderr 1
	procd_close_instance
}

reload_service() {
	# Network events can arrive while packages or service state are changing.
	# The installer explicitly restarts after replacement, using current links.
	(
		mkdir -p /var/lock
		exec 9>/var/lock/daed-install.lock
		flock -n 9 || exit 0
		restart
	)
}

service_triggers() {
	local lan wan wan6
	config_load daed
	config_get lan main lan_network lan
	config_get wan main wan_network wan
	config_get wan6 main wan6_network wan6
	procd_add_reload_trigger daed
	procd_add_interface_trigger 'interface.up' "$lan" /etc/init.d/daed reload
	# Re-evaluate auto WAN bindings after real uplink reconnection. Ordinary
	# interface.update notifications must not restart working connections.
	[ -z "$wan" ] || procd_add_interface_trigger 'interface.up' "$wan" /etc/init.d/daed reload
	[ -z "$wan6" ] || procd_add_interface_trigger 'interface.up' "$wan6" /etc/init.d/daed reload
}
