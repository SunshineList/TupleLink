#!/bin/sh
# SPDX-License-Identifier: MIT
# Read-only checks; also shipped separately so the installer uses the same checks.
set -e

if ! command -v jsonfilter >/dev/null 2>&1 || [ ! -r /usr/share/libubox/jshn.sh ]; then
	echo 'Daed requires jsonfilter and jshn (normally installed with LuCI).' >&2
	exit 1
fi
. /usr/share/libubox/jshn.sh

config_value() {
	uci -q get "daed.main.$1" 2>/dev/null || printf '%s\n' "$2"
}

listen_address() {
	host=$(config_value listen_host lan)
	port=$(config_value listen_port 2023)
	case "$port" in ''|*[!0-9]*) return 1 ;; esac
	[ "$port" -ge 1 ] && [ "$port" -le 65535 ] || return 1
	case "$host" in lan|127.0.0.1) ;; *) return 1 ;; esac
	if [ "$host" = lan ]; then
		network=$(config_value lan_network lan)
		case "$network" in ''|*[!a-zA-Z0-9_]*) return 1 ;; esac
		host=$(ubus call "network.interface.$network" status 2>/dev/null | \
			jsonfilter -e '@["ipv4-address"][0].address' 2>/dev/null) || host=''
	fi
	# The LAN address must be an IPv4 literal; never accept a wildcard bind.
	printf '%s\n' "$host" | awk -F. 'NF!=4 {exit 1} {for(i=1;i<=4;i++) if($i !~ /^[0-9]+$/ || $i>255) exit 1}' || return 1
	[ "$host" != 0.0.0.0 ] || return 1
	printf '%s:%s\n' "$host" "$port"
}

if [ "${1:-}" = --listen ]; then
	listen_address
	exit $?
fi

compatible=1
add_check() {
	json_add_object ''
	json_add_string name "$1"
	json_add_string status "$2"
	json_add_string message "$3"
	json_close_object
	[ "$2" != error ] || compatible=0
}

firmware=unknown
release=unknown
if [ -r /etc/openwrt_release ]; then
	. /etc/openwrt_release
	firmware=${DISTRIB_ID:-OpenWrt}
	release=${DISTRIB_RELEASE:-unknown}
fi
arch=$(uname -m)
kernel=$(uname -r)
listen=$(listen_address) || listen=''
json_init
json_add_string firmware "$firmware"
json_add_string release "$release"
json_add_string architecture "$arch"
json_add_string kernel "$kernel"
json_add_string listen "$listen"
json_add_array checks

if [ -r /etc/openwrt_release ] && [ -x /sbin/uci ]; then
	add_check system ok 'OpenWrt family firmware detected.'
else
	add_check system error 'Requires OpenWrt, ImmortalWrt or iStoreOS with UCI and LuCI.'
fi
case "$arch" in
	x86_64|aarch64) add_check architecture ok "$arch" ;;
	*) add_check architecture error 'This release supports x86_64 and ARM64 only.' ;;
esac
major=${kernel%%.*}
minor=${kernel#*.}; minor=${minor%%.*}
case "$major.$minor" in
	*[!0-9.]*|.*|*.) add_check kernel error 'Unable to determine kernel version.' ;;
	*)
		if [ "$major" -gt 5 ] || { [ "$major" -eq 5 ] && [ "$minor" -ge 17 ]; }; then
			add_check kernel ok "$kernel"
		else
			add_check kernel error 'LAN/WAN transparent proxy requires Linux 5.17 or later.'
		fi ;;
esac
if [ -r /sys/kernel/btf/vmlinux ]; then
	add_check btf ok 'Native kernel BTF is available.'
else
	add_check btf error 'Native kernel BTF is missing. Use firmware built with BTF; this installer does not flash firmware or guess external BTF files.'
fi

kernel_config=''
if [ -r /proc/config.gz ]; then
	kernel_config=$(zcat /proc/config.gz 2>/dev/null) || kernel_config=''
elif [ -r "/boot/config-$kernel" ]; then
	kernel_config=$(cat "/boot/config-$kernel")
fi
if [ -n "$kernel_config" ]; then
	missing=''
	for option in BPF BPF_SYSCALL BPF_JIT CGROUPS KPROBES NET_INGRESS NET_EGRESS NET_SCH_INGRESS NET_CLS_BPF NET_CLS_ACT BPF_STREAM_PARSER KPROBE_EVENTS BPF_EVENTS; do
		if ! printf '%s\n' "$kernel_config" | grep -q "^CONFIG_$option=[ym]$"; then
			missing="$missing CONFIG_$option"
		fi
	done
	if [ -n "$missing" ]; then
		add_check kernel_options error "Required kernel options are missing:$missing"
	else
		add_check kernel_options ok 'Required BPF kernel options are configured.'
	fi
else
	add_check kernel_options warning 'Kernel config is unavailable; BTF/version checks alone cannot prove eBPF will load.'
fi
if [ -n "$listen" ]; then
	add_check listen ok "Management address: $listen"
else
	add_check listen error 'No usable LAN IPv4 address, or invalid listen host/port. Check the selected LAN network in settings.'
fi

services=$(ubus call service list 2>/dev/null) || services='{}'
for other in dae passwall passwall2 openclash mihomo sing-box; do
	active=$(printf '%s' "$services" | jsonfilter -e "@[\"$other\"].instances.*.running" 2>/dev/null) || active=''
	case "$active" in
		*true*) add_check "other_$other" warning "$other is running. Check DNS, interfaces and traffic interception before enabling the proxy; no other service is changed." ;;
	esac
done
json_close_array
json_add_boolean compatible "$compatible"
running=0
active=$(printf '%s' "$services" | jsonfilter -e '@.daed.instances.*.running' 2>/dev/null) || active=''
case "$active" in *true*) running=1 ;; esac
json_add_boolean running "$running"
enabled=0
[ "$(config_value enabled 0)" != 1 ] || enabled=1
json_add_boolean enabled "$enabled"
boot=0
/etc/init.d/daed enabled >/dev/null 2>&1 && boot=1
json_add_boolean autostart "$boot"
version=$(cat /usr/share/daed-router/version 2>/dev/null) || version=uninstalled
json_add_string version "$version"
json_dump
if [ "${1:-}" = --check ]; then
	[ "$compatible" = 1 ]
fi
