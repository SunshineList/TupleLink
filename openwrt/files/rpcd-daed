#!/bin/sh
# SPDX-License-Identifier: MIT
set -e
. /usr/share/libubox/jshn.sh

case "${1:-}" in
list)
	printf '%s\n' '{"status":{},"logs":{},"network":{"action":""},"exitip":{},"notify":{},"notifysave":{},"notifytest":{},"groups":{},"maintenance":{},"maintain":{"action":""},"mirror":{"url":""},"action":{"action":""}}'
	;;
call)
	case "${2:-}" in
	status) /usr/libexec/daed/check ;;
	groups)
		# /health/ready 只接受 loopback 访问，iframe 里的面板够不着，
		# 所以由这里代取。它只返回群组名、策略和「当前选中的节点名」，
		# 不含任何链接或凭据；节点名为空表示该群组还没选出稳定候选。
		listen=$(/usr/libexec/daed/check --listen 2>/dev/null) || listen=''
		json_init
		json_add_array groups
		if [ -n "$listen" ] && command -v uclient-fetch >/dev/null 2>&1; then
			raw=$(uclient-fetch -q -T 3 -O - "http://$listen/health/ready?details=1" 2>/dev/null) || raw='{}'
			if printf '%s' "$raw" | jsonfilter -e '@.groups' >/dev/null 2>&1; then
				# 上限 64 与后端一致；超出部分不显示，避免异常配置撑爆回复。
				#
				# 用「取到的名字是否为空」判断结束，不看 jsonfilter 的退出码：
				# 字段不存在、类型不符都会让 jsonfilter 返回非零，但它们都是
				# 正常情况（比如随机策略没有 candidate_*），不该中断遍历。
				index=0
				while [ "$index" -lt 64 ]; do
					name=$(printf '%s' "$raw" | jsonfilter -e "@.groups[$index].name" 2>/dev/null) || name=''
					[ -n "$name" ] || break
					policy=$(printf '%s' "$raw" | jsonfilter -e "@.groups[$index].policy" 2>/dev/null) || policy=''
					v4=$(printf '%s' "$raw" | jsonfilter -e "@.groups[$index].candidate_ipv4" 2>/dev/null) || v4=''
					v6=$(printf '%s' "$raw" | jsonfilter -e "@.groups[$index].candidate_ipv6" 2>/dev/null) || v6=''
					members=$(printf '%s' "$raw" | jsonfilter -e "@.groups[$index].members" 2>/dev/null) || members=''
					json_add_object
					json_add_string name "$name"
					json_add_string policy "$policy"
					json_add_string candidate_ipv4 "$v4"
					json_add_string candidate_ipv6 "$v6"
					json_add_string members "$members"
					json_close_object
					index=$((index + 1))
				done
			fi
		fi
		json_close_array
		json_dump
		;;
	exitip)
		# 只读：从直连和日常两条路径各探一次出口 IP，回答「分流有没有生效」。
		# 这是唯一会主动发起外网请求的只读接口，所以三层保护：
		# exit-ip 自己每个探测 4 秒超时，这里再加 15 秒整体兜底，
		# 最后校验输出确实是 JSON——脚本被 kill 时可能留下半截。
		tmp=$(mktemp /tmp/daed-exitip.XXXXXX) || { json_init; json_add_string verdict unknown; json_dump; exit 0; }
		/usr/libexec/daed/exit-ip >"$tmp" 2>/dev/null &
		pid=$!
		(
			remaining=15
			while [ "$remaining" -gt 0 ]; do
				kill -0 "$pid" 2>/dev/null || exit 0
				sleep 1
				remaining=$((remaining - 1))
			done
			kill -TERM "$pid" 2>/dev/null || :
		) >/dev/null 2>&1 &
		watchdog=$!
		wait "$pid" 2>/dev/null || :
		kill -TERM "$watchdog" 2>/dev/null || :
		wait "$watchdog" 2>/dev/null || :
		# jsonfilter 走一遍，半截 JSON 在这里就被挡住，不会发给前端。
		if [ -s "$tmp" ] && jsonfilter -i "$tmp" -e '@.verdict' >/dev/null 2>&1; then
			cat "$tmp"
		else
			json_init
			json_add_string verdict unknown
			json_dump
		fi
		rm -f "$tmp"
		;;
	network)
		# The panel can only reach this script, so the diagnostic that explains a
		# broken datapath used to be SSH-only. It is read-only by design: it never
		# touches UCI, the database, routes, firewall or services. Cap the wall clock
		# so a hung probe cannot pin an rpcd worker, and cap the bytes so a huge
		# ruleset cannot blow up the JSON reply.
		json_init
		tmp=$(mktemp /tmp/daed-network.XXXXXX) || { json_add_string output ''; json_add_boolean truncated 0; json_dump; exit 0; }
		/usr/libexec/daed/network-check >"$tmp" 2>&1 &
		pid=$!
		# Poll instead of sleeping once: killing a watchdog that sits in a long
		# sleep leaves that sleeper behind, and a short sleep bounds the orphan.
		(
			remaining=45
			while [ "$remaining" -gt 0 ]; do
				kill -0 "$pid" 2>/dev/null || exit 0
				sleep 1
				remaining=$((remaining - 1))
			done
			kill -TERM "$pid" 2>/dev/null || :
		) >/dev/null 2>&1 &
		watchdog=$!
		status=0
		wait "$pid" 2>/dev/null || status=$?
		kill -TERM "$watchdog" 2>/dev/null || :
		wait "$watchdog" 2>/dev/null || :
		size=$(wc -c <"$tmp" 2>/dev/null || echo 0)
		output=$(tail -c 32768 "$tmp" 2>/dev/null) || output=''
		rm -f "$tmp"
		json_add_string output "$output"
		json_add_boolean truncated "$([ "${size:-0}" -gt 32768 ] && echo 1 || echo 0)"
		[ "$status" = 0 ] || json_add_string note 'The check exited early; the output above may be incomplete.'
		json_dump
		;;
	maintenance) /usr/libexec/daed/luci-proxy --maintenance status ;;
	mirror)
		# 只接受 https 前缀或空串（清空回直连）。校验放在写入之前，
		# 免得一个手滑的值把后续所有下载引到别处。
		input=''; read -r input || :
		json_load "${input:-\{\}}" || exit 1
		url=''; json_get_var url url
		case "$url" in
			'') uci -q delete daed.main.github_mirror ;;
			https://*) uci -q set daed.main.github_mirror="$url" ;;
			*) printf '%s\n' '{"success":false,"code":"invalid_mirror"}'; exit 0 ;;
		esac
		uci -q commit daed || { printf '%s\n' '{"success":false,"code":"state_failed"}'; exit 0; }
		printf '%s\n' '{"success":true}'
		;;
	notify)
		# 读取通知配置。token 永远不回传明文：面板只需要知道「填没填」，
		# 一旦回传，它就会出现在浏览器历史、前端状态树和任何截图里。
		json_init
		json_add_boolean enabled "$([ "$(uci -q get daed.notify.enabled)" = 1 ] && echo 1 || echo 0)"
		json_add_boolean token_set "$([ -n "$(uci -q get daed.notify.token)" ] && echo 1 || echo 0)"
		host=$(uci -q get daed.notify.chat) || host=''
		json_add_string chat "$host"
		json_dump
		;;
	notifysave)
		# token 留空表示「不修改」：面板读不到原值，用户只改 chat_id 时
		# 不能把 token 冲掉。要清空就传 clear_token。
		input=''; read -r input || :
		json_load "${input:-\{\}}" || exit 1
		_enabled=''; json_get_var _enabled enabled >/dev/null 2>&1 || _enabled=''
		_token=''; json_get_var _token token >/dev/null 2>&1 || _token=''
		_chat=''; json_get_var _chat chat >/dev/null 2>&1 || _chat=''
		_clear=''; json_get_var _clear clear_token >/dev/null 2>&1 || _clear=''

		# token 只接受 Telegram 的形态：数字开头、冒号、一段 base64url。
		# 提前挡住手滑粘贴的整段 URL 或空格，免得推送一直静默失败。
		if [ -n "$_token" ]; then
			case "$_token" in
				*[[:space:]]* | *'/'*)
					printf '%s\n' '{"success":false,"code":"invalid_token"}'; exit 0 ;;
				*:* ) : ;;
				*) printf '%s\n' '{"success":false,"code":"invalid_token"}'; exit 0 ;;
			esac
			uci -q set daed.notify.token="$_token"
		fi
		if [ "$_clear" = "1" ]; then uci -q delete daed.notify.token; fi

		# chat_id 可以是数字（用户/群组）或 @channelname。
		if [ -n "$_chat" ]; then
			case "$_chat" in
				-*[!0-9]*) printf '%s\n' '{"success":false,"code":"invalid_chat"}'; exit 0 ;;
				*[[:space:]]*) printf '%s\n' '{"success":false,"code":"invalid_chat"}'; exit 0 ;;
			esac
			uci -q set daed.notify.chat="$_chat"
		fi

		case "$_enabled" in
			1|true) uci -q set daed.notify.enabled=1 ;;
			0|false) uci -q set daed.notify.enabled=0 ;;
		esac

		uci -q commit daed || { printf '%s\n' '{"success":false,"code":"state_failed"}'; exit 0; }
		printf '%s\n' '{"success":true}'
		;;
	notifytest)
		# 手动发一条测试消息。同步执行并带上限，让用户立刻看到结果；
		# 失败时只回固定分类，不回传 URL 或 token。
		tmp=$(mktemp /tmp/daed-notifytest.XXXXXX) || { printf '%s\n' '{"code":"state_failed"}'; exit 0; }
		/usr/libexec/daed/notify test "NaiLink 测试消息" >"$tmp" 2>/dev/null &
		pid=$!
		(
			remaining=12
			while [ "$remaining" -gt 0 ]; do
				kill -0 "$pid" 2>/dev/null || exit 0
				sleep 1
				remaining=$((remaining - 1))
			done
			kill -TERM "$pid" 2>/dev/null || :
		) >/dev/null 2>&1 &
		watchdog=$!
		wait "$pid" 2>/dev/null || :
		kill -TERM "$watchdog" 2>/dev/null || :
		wait "$watchdog" 2>/dev/null || :
		result=''; [ -s "$tmp" ] && result=$(head -n1 "$tmp" 2>/dev/null)
		rm -f "$tmp"
		[ -n "$result" ] || result='send_failed'
		json_init
		json_add_string code "$result"
		json_dump
		;;
	maintain)
		input=''; read -r input || :
		json_load "${input:-\{\}}" || exit 1
		action=''; json_get_var action action
		case "$action" in check|update|geodata) /usr/libexec/daed/luci-proxy --maintenance "$action" ;;
		*) printf '%s\n' '{"success":false,"code":"invalid_action"}' ;; esac
		;;
	logs)
		json_init
		# 一条 dae 记录可能跨几十行：候选列表写在 msg 的引号里，中位数 46 行。
		# 按物理行取行数只剩几十条记录，所以这里按「记录」计数。
		#
		# 这些上限是为 debug 级别排障定的：一次刷网页能写出几十 KB，
		# 窗口太小的话面板上的分流视图永远是空的，等于没有。
		# 同时它们也挡住 busybox awk 的内存：400 条 × 十几行仍在可控范围，
		# 真正超长的候选列表只在 daed.log 里保留原文，面板按需展开头部。
		# 每条记录保留头 12 行和最后一行，中间换成计数标记：
		# 末行带着收尾引号和 group=/dialer= 等字段，丢了它 msg 就不闭合，
		# 整条记录会退化成无法解析的孤立行。完整列表在面板里可以展开。
		# LC_ALL=C 是必需的：busybox awk 在 UTF-8 locale 下遇到候选名里的
		# 非 ASCII 字节会直接 towc 失败退出。
		logs=$(LC_ALL=C tail -c 1048576 /var/log/daed/daed.log 2>/dev/null | LC_ALL=C awk '
			function emit(   i) {
				if (!body) return
				slot = (slot + 1) % 400
				n[slot] = ""
				if (body <= 13) {
					for (i = 1; i <= body; i++) n[slot] = n[slot] "\n" buf[i]
				} else {
					for (i = 1; i <= 12; i++) n[slot] = n[slot] "\n" buf[i]
					n[slot] = n[slot] "\n   … " (body - 13) " more lines"
					n[slot] = n[slot] "\n" buf[body]
				}
				body = 0
				if (total < 400) total++
			}
			/^(time=|\{|\[(trace|debug|info|warn|warning|error|fatal|panic)\])/ { emit() }
			{ buf[++body] = $0 }
			END {
				emit()
				from = (total < 400) ? 0 : (slot + 1) % 400
				for (k = 0; k < total; k++) printf "%s\n", substr(n[(from + k) % 400], 2)
			}
		' | tail -c 131072 | \
			sed -E 's#[a-zA-Z][a-zA-Z0-9+.-]*://[^[:space:]"<>]+#[URL REDACTED]#g; s/([Tt]oken|[Pp]assword|[Aa]uthorization)([=: ]+)[^, ]+/\1\2[REDACTED]/g') || logs=''
		json_add_string logs "$logs"
		json_dump
		;;
	action)
		input=''
		read -r input || :
		json_load "${input:-\{\}}" || exit 1
		action=''
		json_get_var action action
		case "$action" in start|restart|stop|boot_enable|boot_disable) ;; *)
			json_init; json_add_boolean success 0; json_dump; exit 0 ;;
		esac
		mkdir -p /var/lock
		exec 9>/var/lock/daed-install.lock
		if ! flock -n 9; then
			json_init
			json_add_boolean success 0
			json_add_string message 'NaiLink 正在安装或执行其他服务操作，请稍后重试。'
			json_dump
			exit 0
		fi
		success=1
		case "$action" in
		start|restart)
			if /usr/libexec/daed/check --check >/dev/null; then
				uci set daed.main.enabled=1
				uci commit daed
				/etc/init.d/daed "$action" >/dev/null 2>&1 || success=0
			else success=0; fi ;;
		stop)
			uci set daed.main.enabled=0
			uci commit daed
			/etc/init.d/daed stop >/dev/null 2>&1 || success=0 ;;
		boot_enable) /etc/init.d/daed enable >/dev/null 2>&1 || success=0 ;;
		boot_disable) /etc/init.d/daed disable >/dev/null 2>&1 || success=0 ;;
		*) success=0 ;;
		esac
		json_init
		json_add_boolean success "$success"
		json_dump
		;;
	*) exit 1 ;;
	esac
	;;
*) exit 1 ;;
esac
