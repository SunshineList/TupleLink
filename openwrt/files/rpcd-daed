#!/bin/sh
# SPDX-License-Identifier: MIT
set -e
. /usr/share/libubox/jshn.sh

case "${1:-}" in
list)
	printf '%s\n' '{"status":{},"logs":{},"network":{"action":""},"maintenance":{},"maintain":{"action":""},"mirror":{"url":""},"action":{"action":""}}'
	;;
call)
	case "${2:-}" in
	status) /usr/libexec/daed/check ;;
	network)
		# The panel can only reach this script, so the diagnostic that explains a
		# broken datapath used to be SSH-only. It is read-only by design: it never
		# touches UCI, the database, routes, firewall or services. Cap the wall clock
		# so a hung probe cannot pin an rpcd worker, and cap the bytes so a huge
		# ruleset cannot blow up the JSON reply.
		json_init
		tmp=$(mktemp /tmp/daed-network.XXXXXX) || { json_add_string output ''; json_add_boolean truncated 0; json_dump; exit 0; }
		/usr/libexec/daed/network-check >"$tmp" 2>&1 &
		pid=$!
		# Poll instead of sleeping once: killing a watchdog that sits in a long
		# sleep leaves that sleeper behind, and a short sleep bounds the orphan.
		(
			remaining=45
			while [ "$remaining" -gt 0 ]; do
				kill -0 "$pid" 2>/dev/null || exit 0
				sleep 1
				remaining=$((remaining - 1))
			done
			kill -TERM "$pid" 2>/dev/null || :
		) >/dev/null 2>&1 &
		watchdog=$!
		status=0
		wait "$pid" 2>/dev/null || status=$?
		kill -TERM "$watchdog" 2>/dev/null || :
		wait "$watchdog" 2>/dev/null || :
		size=$(wc -c <"$tmp" 2>/dev/null || echo 0)
		output=$(tail -c 32768 "$tmp" 2>/dev/null) || output=''
		rm -f "$tmp"
		json_add_string output "$output"
		json_add_boolean truncated "$([ "${size:-0}" -gt 32768 ] && echo 1 || echo 0)"
		[ "$status" = 0 ] || json_add_string note 'The check exited early; the output above may be incomplete.'
		json_dump
		;;
	maintenance) /usr/libexec/daed/luci-proxy --maintenance status ;;
	mirror)
		# 只接受 https 前缀或空串（清空回直连）。校验放在写入之前，
		# 免得一个手滑的值把后续所有下载引到别处。
		input=''; read -r input || :
		json_load "${input:-\{\}}" || exit 1
		url=''; json_get_var url url
		case "$url" in
			'') uci -q delete daed.main.github_mirror ;;
			https://*) uci -q set daed.main.github_mirror="$url" ;;
			*) printf '%s\n' '{"success":false,"code":"invalid_mirror"}'; exit 0 ;;
		esac
		uci -q commit daed || { printf '%s\n' '{"success":false,"code":"state_failed"}'; exit 0; }
		printf '%s\n' '{"success":true}'
		;;
	maintain)
		input=''; read -r input || :
		json_load "${input:-\{\}}" || exit 1
		action=''; json_get_var action action
		case "$action" in check|update|geodata) /usr/libexec/daed/luci-proxy --maintenance "$action" ;;
		*) printf '%s\n' '{"success":false,"code":"invalid_action"}' ;; esac
		;;
	logs)
		json_init
		# 一条 dae 记录可能跨几十行：候选列表写在 msg 的引号里，中位数 46 行。
		# 按物理行取 120 行只剩几十条记录，所以这里按「记录」回数 120 条。
		# 每条记录保留头 12 行和最后一行，中间换成计数标记：
		# 末行带着收尾引号和 group=/dialer= 等字段，丢了它 msg 就不闭合，
		# 整条记录会退化成无法解析的孤立行。完整列表在面板里可以展开。
		# LC_ALL=C 是必需的：busybox awk 在 UTF-8 locale 下遇到候选名里的
		# 非 ASCII 字节会直接 towc 失败退出。
		logs=$(LC_ALL=C tail -c 262144 /var/log/daed/daed.log 2>/dev/null | LC_ALL=C awk '
			function emit(   i) {
				if (!body) return
				slot = (slot + 1) % 120
				n[slot] = ""
				if (body <= 13) {
					for (i = 1; i <= body; i++) n[slot] = n[slot] "\n" buf[i]
				} else {
					for (i = 1; i <= 12; i++) n[slot] = n[slot] "\n" buf[i]
					n[slot] = n[slot] "\n   … " (body - 13) " more lines"
					n[slot] = n[slot] "\n" buf[body]
				}
				body = 0
				if (total < 120) total++
			}
			/^(time=|\{|\[(trace|debug|info|warn|warning|error|fatal|panic)\])/ { emit() }
			{ buf[++body] = $0 }
			END {
				emit()
				from = (total < 120) ? 0 : (slot + 1) % 120
				for (k = 0; k < total; k++) printf "%s\n", substr(n[(from + k) % 120], 2)
			}
		' | tail -c 32768 | \
			sed -E 's#[a-zA-Z][a-zA-Z0-9+.-]*://[^[:space:]"<>]+#[URL REDACTED]#g; s/([Tt]oken|[Pp]assword|[Aa]uthorization)([=: ]+)[^, ]+/\1\2[REDACTED]/g') || logs=''
		json_add_string logs "$logs"
		json_dump
		;;
	action)
		input=''
		read -r input || :
		json_load "${input:-\{\}}" || exit 1
		action=''
		json_get_var action action
		case "$action" in start|restart|stop|boot_enable|boot_disable) ;; *)
			json_init; json_add_boolean success 0; json_dump; exit 0 ;;
		esac
		mkdir -p /var/lock
		exec 9>/var/lock/daed-install.lock
		if ! flock -n 9; then
			json_init
			json_add_boolean success 0
			json_add_string message 'NaiLink 正在安装或执行其他服务操作，请稍后重试。'
			json_dump
			exit 0
		fi
		success=1
		case "$action" in
		start|restart)
			if /usr/libexec/daed/check --check >/dev/null; then
				uci set daed.main.enabled=1
				uci commit daed
				/etc/init.d/daed "$action" >/dev/null 2>&1 || success=0
			else success=0; fi ;;
		stop)
			uci set daed.main.enabled=0
			uci commit daed
			/etc/init.d/daed stop >/dev/null 2>&1 || success=0 ;;
		boot_enable) /etc/init.d/daed enable >/dev/null 2>&1 || success=0 ;;
		boot_disable) /etc/init.d/daed disable >/dev/null 2>&1 || success=0 ;;
		*) success=0 ;;
		esac
		json_init
		json_add_boolean success "$success"
		json_dump
		;;
	*) exit 1 ;;
	esac
	;;
*) exit 1 ;;
esac
